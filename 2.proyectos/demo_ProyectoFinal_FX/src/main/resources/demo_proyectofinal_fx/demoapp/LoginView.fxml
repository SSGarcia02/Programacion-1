<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="500" prefWidth="800" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="demo_proyectofinal_fx.demoapp.viewController.LoginViewController">
    <children>
        <!-- Panel izquierdo - Logo e información -->
        <VBox alignment="CENTER" spacing="20.0" prefWidth="400.0" style="-fx-background-color: #2c3e50; -fx-border-color: #34495e; -fx-border-width: 0 2 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <VBox alignment="CENTER" spacing="15">
                <Label text="💪" style="-fx-font-size: 64px;"/>
                <Label text="GIMNASIO UQ" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Sistema Integral de Gestión" style="-fx-font-size: 16px; -fx-text-fill: #ecf0f1;"/>
            </VBox>

            <Separator prefWidth="300.0" style="-fx-background-color: #34495e;"/>

            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20 0 0 0;">
                <Label text="🏋️ Entrenadores Certificados" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
                <Label text="📊 Gestión Avanzada" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
                <Label text="👥 Control de Accesos" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
                <Label text="💳 Sistema de Membresías" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
            </VBox>
        </VBox>

        <!-- Panel derecho - Formulario de login -->
        <VBox alignment="CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="400.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="60.0" left="60.0" right="60.0" top="60.0" />
            </padding>

            <VBox alignment="CENTER_LEFT" spacing="25.0" prefWidth="300.0">
                <Label text="Iniciar Sesión" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <VBox spacing="8">
                    <Label text="TIPO DE USUARIO" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="comboTipoUsuario" prefWidth="300.0" promptText="Seleccione su rol"
                              style="-fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="USUARIO" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtUsuario" prefWidth="300.0" promptText="Ingrese su nombre de usuario"
                               style="-fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="CONTRASEÑA" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="txtPassword" prefWidth="300.0" promptText="Ingrese su contraseña"
                                   style="-fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #bdc3c7; -fx-padding: 8;"/>
                </VBox>

                <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#onLogin" prefWidth="300.0"
                        text="ACCEDER AL SISTEMA"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 4; -fx-padding: 12;"/>

                <Label fx:id="lblMensaje" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: bold; -fx-alignment: center;"
                       textAlignment="CENTER" wrapText="true" prefWidth="300.0"/>
            </VBox>

            <!-- Información de ayuda -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
                <Label text="¿Problemas para acceder?" style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;"/>
                <Label text="Contacte al administrador del sistema" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </children>
</AnchorPane>